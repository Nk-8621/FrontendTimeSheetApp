VITE_API_BASE_URL=http://localhost:5160

# Microsoft (Entra ID) login - required. There is no other way to sign in.
#
# To enable:
#   1. Ask whoever administers your Azure/Entra tenant for the Application
#      (client) ID and Directory (tenant) ID from the App Registration.
#   2. Make sure this app's URL is registered as a Redirect URI on that App
#      Registration, under the "Single-page application" platform (not
#      "Web") - e.g. http://localhost:5173 for local dev.
#   3. Make sure the App Registration has "Expose an API" -> a scope named
#      `access_as_user` (App ID URI api://<ClientId>), with this same app
#      added as an authorized client application for that scope - this is
#      what lets the frontend get a token the backend API will accept.
#   4. Fill in the values below and restart the dev server.

VITE_AZURE_CLIENT_ID=f2d17e97-ebc7-4491-8e9f-52f2f57d02e4
VITE_AZURE_TENANT_ID=432a4219-1a46-4b7f-92ce-aae7bc705c26
VITE_AZURE_REDIRECT_URI=http://timesheet.carbynetech.com:8077
