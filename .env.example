# Microsoft (Entra ID) login — leave these blank to run in dev mode
# (no login required; use the sidebar's "Viewing as" switcher instead).
#
# To enable real Microsoft login:
#   1. Ask whoever administers your Azure/Entra tenant to create an
#      "App registration" for Meridian in the Entra admin center.
#   2. They'll give you a Client ID and Tenant ID.
#   3. Register this app's URL (e.g. http://localhost:5173 for local dev)
#      as a redirect URI on that App Registration — Azure AD will refuse
#      to redirect back here otherwise.
#   4. Fill in the values below and restart the dev server.

VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Backend API — the .NET Web API from src/Meridian.Api.
# `dotnet run` prints the actual port on startup; update this to match.
VITE_API_BASE_URL=http://localhost:5160
