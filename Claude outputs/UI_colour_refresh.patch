+/*
+ * Meridian colour system.
+ *
+ * Every colour in the app should come from a token in this file - no hex
+ * values inside component CSS or inline styles. Each colour has one job:
+ *
+ *   Brand / action  -> --oxide*      (primary buttons, links, active nav, billable)
+ *   Approval status -> --amber (pending), --oxide (pending L2), --verd (approved),
+ *                      --clay (returned / rejected / errors ONLY)
+ *   Day types       -> --wfh*, --leave*, --holiday*, --off*  (never reuse a status colour)
+ *   Billing split   -> --oxide (billable), --partial (partial billable), --nonBill (non-billable)
+ *
+ * Text tokens (--ink, --ink2, --slate, --slate2) all pass WCAG AA (4.5:1)
+ * on both --paper and --canvas.
+ */
+:root {
+  /* ---- Text ---- */
+  --ink: #101828;
+  --ink2: #344054;
+  --slate: #4F5B6B;
+  --slate2: #5F6B7C;
+  --placeholder: #A9B4C2;
+
+  /* ---- Surfaces & lines ---- */
+  --canvas: #E9EEF4;     /* page background - darker than cards so cards lift off it */
+  --paper: #FFFFFF;      /* cards, drawers, tables */
+  --paperAlt: #F7F9FC;   /* table headers, footers, totals columns, expanded rows */
+  --paperHover: #F2F6FB; /* table row hover */
+  --rule: #E4E9EF;       /* lines inside a card */
+  --ruleStrong: #C3CDD8; /* input borders, header underlines */
+  --cardBorder: #D5DDE6; /* outer edge of a card */
+  --scrim: rgba(16, 24, 40, 0.45);
+
+  /* ---- Brand / primary action ---- */
+  --oxide: #1D5FA8;
+  --oxideHover: #174E8C;
+  --oxideDeep: #0B2540;  /* sidebar */
+  --oxideTint: #E6EFF9;
+  --oxideLine: #A9C7E8;
+  --oxideMid: #3B76BC;
+  --onDark: #FFFFFF;
+  --onDarkText: #D2DEEA;
+  --onDarkMuted: #8FA9C2;
+  --onDarkLine: rgba(255, 255, 255, 0.12);
+  --onDarkFill: rgba(255, 255, 255, 0.08);
+  --onDarkHover: rgba(255, 255, 255, 0.07);
+  --onDarkActive: #1D5FA8;
+  --onDarkAccent: #9CC8F2;
+  --onDarkWarn: #F5C66B;
+  --onDarkBad: #FDA29B;
+  --msButton: #2F2F2F;      /* Microsoft sign-in button, per Microsoft's brand guidance */
+  --msButtonHover: #1F1F1F;
+
+  /* ---- Status: pending / needs attention ---- */
+  --amber: #8A4B00;
+  --amberTint: #FFF4DB;
+  --amberLine: #F5C66B;
+  --amberSolid: #E8890C; /* badges, capacity bar "under" */
+  --onAmberSolid: #1B1300;
+
+  /* ---- Status: approved / complete ---- */
+  --verd: #0B6B50;
+  --verdTint: #DFF4EA;
+  --verdLine: #86D1B1;
+  --verdSolid: #12936B;
+
+  /* ---- Status: returned / rejected / error ---- */
+  --clay: #B42318;
+  --clayTint: #FDECEA;
+  --clayLine: #F4B4AC;
+  --claySolid: #D92D20;
+
+  /* ---- Draft / neutral status ---- */
+  --draftTint: #F2F4F7;
+  --draftLine: #D0D5DD;
+
+  /* ---- Day types (calendar) - deliberately separate from status colours ---- */
+  --working: #174E8C;
+  --workingTint: #EEF4FB;
+  --wfh: #0B6577;
+  --wfhTint: #DDF2F5;
+  --wfhLine: #8FD0DB;
+  --leave: #5B37B0;
+  --leaveTint: #EFE9FC;
+  --leaveStripe: #E4DAFA;
+  --leaveLine: #C9B8F2;
+  --holiday: #A3245E;
+  --holidayTint: #FCE7F0;
+  --holidayStripe: #F8D5E4;
+  --holidayLine: #F0B3CD;
+  --off: #5F6B7C;
+  --offTint: #F2F4F7;
+  --locked: #EEF1F5;
+  --lockedStripe: #E3E8EE;
+
+  /* ---- Billing split ---- */
+  --partial: #7FAEE3;
+  --nonBill: #B4BFCC;
+  --nonBillStripe: #CDD5DF;
+
+  /* ---- Heat scale (Team Compliance hours per day) ---- */
+  --heatNone: #F2F4F7;
+  --heatLow: #FFF4DB;
+  --heatMid: #DCE9F7;
+  --heatHigh: #B9D3F0;
+
+  /* Kept for older references; new code should use the role tokens above. */
+  --violet: var(--partial);
+  --violetTint: var(--wfhTint);
+  --violetLine: var(--wfhLine);
+
+  --r: 6px;
+  --rLg: 8px;
+
+  --sh1: 0 1px 3px rgba(16, 24, 40, 0.08), 0 1px 2px rgba(16, 24, 40, 0.04);
+  --sh2: 0 4px 14px rgba(16, 24, 40, 0.10), 0 1px 3px rgba(16, 24, 40, 0.06);
+  --sh3: 0 18px 50px rgba(11, 37, 64, 0.22);
+
+  --mono: 'IBM Plex Mono', ui-monospace, monospace;
+  --sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
+
+  /* Two deliberate heading sizes, used consistently instead of one weight
+     doing both jobs: page titles (PageHeader) vs. section/drawer labels
+     (drawer heads, accordion section titles, card headings). The smallest
+     text anywhere in the app is 11px. */
+  --fsPageTitle: 19px;
+  --fsSectionTitle: 15px;
+}
